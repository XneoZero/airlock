{
  "name": "airlock",
  "version": "0.1.0",
  "description": "A capability airlock for agents: a narrow, auditable SSH channel to a server workspace.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "airlock": "bin/airlock.mjs",
    "airlock-mcp": "bin/airlock-mcp.mjs",
    "airlock-broker": "bin/airlock-broker.mjs",
    "airlock-deploy": "bin/airlock-deploy.mjs",
    "airlock-deploy-mcp": "bin/airlock-deploy-mcp.mjs",
    "airlock-deployer": "bin/airlock-deployer.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:auto": "node --test",
    "typecheck": "tsc --noEmit",
    "cli": "node bin/airlock.mjs",
    "mcp": "node bin/airlock-mcp.mjs",
    "deploy": "node bin/airlock-deploy.mjs",
    "ui": "node bin/airlock-deploy-ui.mjs"
  },
  "dependencies": {
    "tar": "^7.5.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "ssh",
    "agent",
    "remote-development",
    "capability-broker"
  ],
  "license": "MIT"
}
