{
  "name": "airlock",
  "version": "0.1.0",
  "description": "Narrow, auditable SSH channels for agents: remote file editing, and versioned deploys with automatic rollback.",
  "keywords": [
    "mcp",
    "ssh",
    "agent",
    "deploy",
    "rollback",
    "remote-development",
    "capability-broker"
  ],
  "license": "MIT",
  "author": "Xneo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XneoZero/airlock.git"
  },
  "bugs": {
    "url": "https://github.com/XneoZero/airlock/issues"
  },
  "homepage": "https://github.com/XneoZero/airlock#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "airlock": "bin/airlock.mjs",
    "airlock-mcp": "bin/airlock-mcp.mjs",
    "airlock-broker": "bin/airlock-broker.mjs",
    "airlock-deploy": "bin/airlock-deploy.mjs",
    "airlock-deploy-mcp": "bin/airlock-deploy-mcp.mjs",
    "airlock-deployer": "bin/airlock-deployer.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:auto": "node --test",
    "typecheck": "tsc --noEmit",
    "cli": "node bin/airlock.mjs",
    "mcp": "node bin/airlock-mcp.mjs",
    "deploy": "node bin/airlock-deploy.mjs",
    "ui": "node bin/airlock-deploy-ui.mjs"
  },
  "dependencies": {
    "tar": "^7.5.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "examples",
    "skills",
    "airlock-ui.cmd",
    "airlock-ui.sh",
    "README.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE"
  ]
}
