# 统一换行符：仓库内一律 LF，检出到任何平台都不改动
* text=auto eol=lf

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做文本转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.gz binary
*.tar binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
