{
  "default": "web-prod",
  "profiles": {
    "web-prod": {
      "host": "ssh.example.com",
      "user": "airlock-deploy",
      "port": 22,
      "identityFile": "C:/Users/you/.ssh/airlock-deploy",
      "userKnownHostsFile": "C:/Users/you/.ssh/known_hosts",
      "hostKeyChecking": "yes",
      "serverId": "srv-prod01",
      "app": "web",
      "deployerCommand": "node /opt/airlock/bin/airlock-deployer.mjs --config /etc/airlock/deployer.json",
      "workspace": "C:/work/my-web"
    },
    "api-prod": {
      "host": "ssh.example.com",
      "user": "airlock-deploy",
      "port": 22,
      "identityFile": "C:/Users/you/.ssh/airlock-deploy",
      "hostKeyChecking": "yes",
      "serverId": "srv-prod01",
      "app": "api",
      "deployerCommand": "node /opt/airlock/bin/airlock-deployer.mjs --config /etc/airlock/deployer.json",
      "workspace": "C:/work/my-api"
    },
    "web-staging": {
      "host": "10.0.0.12",
      "user": "deploy",
      "identityFile": "C:/Users/you/.ssh/airlock-staging",
      "hostKeyChecking": "accept-new",
      "serverId": "srv-stage01",
      "app": "web",
      "deployerCommand": "node /opt/airlock/bin/airlock-deployer.mjs --config /etc/airlock/deployer.json",
      "workspace": "C:/work/my-web"
    }
  }
}
